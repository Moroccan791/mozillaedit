# Python virtual environments & cache
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# Browser binaries & disposable caches
**/AsideDaemon/
**/aside_component_crx_cache/
**/component_crx_cache/
**/extensions_crx_cache/
**/Crashpad/
**/ShaderCache/
**/GPUPersistentCache/
**/Default/Cache/
**/Default/Code Cache/
**/Default/GPUCache/
**/Default/DawnWebGPUCache/
**/Default/DawnGraphiteCache/
**/Default/Shared Dictionary/cache/
**/AsideAdBlock/Cache/
*.exe
*.dll

# Originals backup & temp files (>100MB)
raw/_originals/
raw/temp_*
*.zip
**/proof-input/

# AI binary model weights & large rendered video outputs
*.bin
output/
**/output/
**/cache/

# Un-ignore specific analysis screenshots, strips, and subtitle/score metadata
!setup/output/strips/
!setup/output/strips/**
!setup/cache/captions.ass
!setup/cache/ec.jpg
!setup/cache/endcard.jpg
!setup/projects/**/captions.ass
!setup/projects/**/raw/*.json

# Logs and temp files
*.log
*.err
*.out
tmp*

# Engine render intermediates in sample runs (finals + reports are kept)
test-sample-mp4/**/renders/**/*.mp4
test-sample-mp4/**/renders/**/*.wav
