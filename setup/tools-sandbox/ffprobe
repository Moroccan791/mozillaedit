#!/usr/bin/python3
"""Minimal ffprobe-compatible CLI backed by PyAV.

Sandbox substitute only: supports the exact query surface the aive
pipeline uses (show_format/show_streams/show_entries/show_packets,
select_streams, json/csv/default writers, -count_frames).
Not a general ffprobe replacement.
"""
from __future__ import annotations

import base64
import hashlib
import json
import sys
from pathlib import Path

_MISS = object()


def _dec(v, nd=6):
    return f"{float(v):.{nd}f}"


def _fps_str(rate):
    if rate is None:
        return "0/0"
    n, d = rate.numerator, rate.denominator
    return f"{n}/{d}"


def main(argv):
    path = None
    show_format = show_streams = show_packets = count_frames = False
    entries = None
    ofmt = "default"
    oopts = {"print_section": 1, "noprint_wrappers": 0, "nokey": 0, "s": ","}
    select = None
    hash_algo = None

    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("-hide_banner", "-v", "-loglevel"):
            i += 2 if a != "-hide_banner" else 1
            continue
        if a == "-protocol_whitelist":
            i += 2
            continue
        if a == "-show_format":
            show_format = True
        elif a == "-show_streams":
            show_streams = True
        elif a == "-show_packets":
            show_packets = True
        elif a == "-count_frames":
            count_frames = True
        elif a == "-select_streams":
            select = argv[i + 1]
            i += 1
        elif a == "-show_entries":
            entries = argv[i + 1]
            i += 1
        elif a in ("-of", "-print_format"):
            ofmt = argv[i + 1]
            i += 1
        elif a == "-show_data_hash":
            hash_algo = argv[i + 1]
            i += 1
        elif a == "-i":
            path = argv[i + 1]
            i += 1
        elif not a.startswith("-") and path is None and a != "-":
            path = a
        i += 1

    if ofmt.startswith(("csv", "default", "json")):
        raw = ofmt
        head, _, rest = raw.partition(":")
        fmt_name, _, first_kv = head.partition("=")
        pairs = ([first_kv] if first_kv else []) + (rest.split(":") if rest else [])
        ofmt = fmt_name
        for part in pairs:
            if not part:
                continue
            k, _, v = part.partition("=")
            if k == "p":
                oopts["print_section"] = int(v)
            elif k == "s":
                oopts["s"] = v if v != "" else ","
            elif k == "noprint_wrappers":
                oopts["noprint_wrappers"] = int(v)
            elif k == "nokey":
                oopts["nokey"] = int(v)
            elif k == "print_section":
                oopts["print_section"] = int(v)

    if path is None:
        sys.stderr.write("ffprobe: missing input file\n")
        return 1
    p = Path(path)
    if not p.is_file():
        sys.stderr.write(f"{path}: No such file or directory\n")
        return 1

    try:
        import av
    except ImportError:
        sys.stderr.write("ffprobe shim: PyAV not importable\n")
        return 1

    reqs = []  # list of (section, [keys])
    if entries:
        for chunk in entries.split(":"):
            if "=" not in chunk:
                continue
            sec, keys = chunk.split("=", 1)
            ks = [k.strip() for k in keys.split(",") if k.strip()] if keys else []
            reqs.append((sec, ks))

    def want(section, key_map):
        if entries is None:
            return None
        for sec, keys in reqs:
            if sec == section:
                out = dict(key_map)
                if keys:
                    out = {k: key_map.get(k) for k in keys}
                return out
        return None

    try:
        container = av.open(str(p))
    except Exception as exc:
        sys.stderr.write(f"{path}: {exc}\n")
        return 1

    streams_out = []
    packets_out = []
    fmt_out = None
    try:
        streams = list(container.streams)

        def selected(st):
            if select is None:
                return True
            kind, _, idx = select.partition(":")
            kind = kind.strip()
            if kind in ("v", "a", "s", "d", "t"):
                want_type = {"v": "video", "a": "audio", "s": "subtitle",
                             "d": "data", "t": "attachment"}[kind]
                if st.type != want_type:
                    return False
                if idx != "":
                    ordinal = sum(1 for x in streams if x.type == st.type
                                  and x.index < st.index)
                    if ordinal != int(idx):
                        return False
                return True
            return select == str(st.index)

        def stream_fields(st):
            tb = st.time_base
            dur_units = st.duration
            dur_sec = (float(dur_units * tb)
                       if dur_units is not None and tb is not None else None)
            if dur_sec is None and container.duration is not None:
                dur_sec = float(container.duration / 1_000_000)
            start_units = st.start_time
            start_sec = (float(start_units * tb)
                         if start_units is not None and tb is not None else 0.0)
            codec = st.codec_context
            fields = {
                "index": str(st.index),
                "codec_name": getattr(codec, "name", "") or "unknown",
                "codec_long_name": getattr(codec, "long_name", "") or "unknown",
                "codec_type": st.type,
                "profile": str(getattr(codec, "profile", "") or ""),
                "duration": _dec(dur_sec) if dur_sec is not None else "N/A",
                "start_time": _dec(start_sec) if start_sec is not None else "N/A",
                "time_base": str(tb) if tb is not None else "N/A",
                "duration_ts": str(dur_units) if dur_units is not None else "N/A",
                "nb_frames": str(st.frames) if getattr(st, "frames", 0)
                             and st.frames > 0 else "N/A",
                "bit_rate": str(getattr(codec, "bit_rate", 0) or 0),
            }
            if st.type == "video":
                rate = (getattr(st, "base_rate", None)
                        or getattr(st, "guessed_rate", None)
                        or st.average_rate)
                fields["width"] = str(getattr(codec, "width", 0) or 0)
                fields["height"] = str(getattr(codec, "height", 0) or 0)
                fields["r_frame_rate"] = _fps_str(rate)
                fields["avg_frame_rate"] = _fps_str(st.average_rate)
                fmt = getattr(codec, "format", None)
                fields["pix_fmt"] = str(fmt.name) if fmt is not None else ""
            elif st.type == "audio":
                fields["sample_rate"] = str(getattr(codec, "sample_rate", 0) or 0)
                fields["channels"] = str(getattr(codec, "channels", 0) or 0)
                layout = getattr(codec, "channel_layout", None)
                fields["channel_layout"] = str(layout) if layout else ""
            if count_frames and st.type == "video":
                n = 0
                for pkt in container.demux([st]):
                    try:
                        for _ in pkt.decode():
                            n += 1
                    except Exception:
                        pass
                fields["nb_read_frames"] = str(n)
                container.seek(0)
            return fields

        if show_streams or (entries and any(s == "stream" for s, _ in reqs)):
            fw = want("stream", {})
            for st in streams:
                if not selected(st):
                    continue
                full = stream_fields(st)
                if fw is None:
                    streams_out.append(dict(full))
                elif fw:
                    streams_out.append({k: full.get(k, _MISS) for k in fw})
                else:
                    streams_out.append({})

        if show_packets or (entries and any(s == "packet" for s, _ in reqs)):
            fw = want("packet", {}) or {}
            for st in streams:
                if not selected(st):
                    continue
                container.seek(0)
                for pkt in container.demux([st]):
                    if pkt.pts is None and pkt.dts is None:
                        continue
                    tb = st.time_base
                    rec = {
                        "stream_index": str(st.index),
                        "pts": "N/A" if pkt.pts is None else str(pkt.pts),
                        "pts_time": "N/A" if pkt.pts is None
                                    else _dec(float(pkt.pts * tb)),
                        "dts": "N/A" if pkt.dts is None else str(pkt.dts),
                        "duration": "N/A" if pkt.duration is None
                                    else str(pkt.duration),
                        "duration_time": "N/A" if pkt.duration is None
                                          else _dec(float(pkt.duration * tb)),
                        "size": str(pkt.size),
                        "pos": str(pkt.pos if pkt.pos is not None else -1),
                    }
                    if hash_algo:
                        try:
                            data = bytes(pkt)
                        except Exception:
                            try:
                                data = pkt.to_bytes()
                            except Exception:
                                data = None
                        if data is None:
                            rec["data_hash"] = "N/A"
                        else:
                            h = hashlib.new(hash_algo)
                            h.update(data)
                            rec["data_hash"] = base64.b64encode(
                                h.digest()).decode("ascii")
                    if fw:
                        rec = {k: rec.get(k, _MISS) for k in fw}
                    packets_out.append(rec)
                container.seek(0)

        if show_format or (entries and any(s == "format" for s, _ in reqs)):
            duration = None
            if container.duration is not None:
                duration = float(container.duration / 1_000_000)
            size = p.stat().st_size
            bit_rate = ""
            if duration and duration > 0:
                bit_rate = str(int(round(size * 8 / duration)))
            full = {
                "filename": str(p),
                "nb_streams": str(len(streams)),
                "nb_programs": "0",
                "format_name": container.format.name,
                "format_long_name": container.format.long_name,
                "duration": _dec(duration) if duration is not None else "N/A",
                "size": str(size),
                "bit_rate": bit_rate or "N/A",
                "start_time": _dec(0.0),
                "probe_score": "50",
            }
            fw = want("format", {})
            if fw is None:
                fmt_out = dict(full)
            elif fw:
                fmt_out = {k: full.get(k, _MISS) for k in fw}
            else:
                fmt_out = {}
    finally:
        container.close()

    def _clean(o):
        if isinstance(o, dict):
            return {k: _clean(v) for k, v in o.items() if v is not _MISS}
        if isinstance(o, list):
            return [_clean(v) for v in o]
        return o

    if entries is None:
        if show_streams or show_packets:
            if show_streams:
                result_streams = {"streams": streams_out}
            else:
                result_streams = {}
            if show_packets:
                result_streams["packets"] = packets_out
        else:
            result_streams = {}
        if show_format:
            result_streams["format"] = fmt_out
        if ofmt == "json":
            sys.stdout.write(json.dumps(result_streams, indent=2))
            return 0
        for sec, rows in (("stream", streams_out), ("packet", packets_out),
                          ("format", [fmt_out] if fmt_out else [])):
            if not rows:
                continue
            for row in rows:
                if isinstance(row, dict):
                    for k, v in row.items():
                        if v is _MISS:
                            continue
                        sys.stdout.write(f"{k}={v}\n" if not oopts["nokey"]
                                         else f"{v}\n")
                else:
                    sys.stdout.write(f"{row}\n")
        return 0

    if ofmt == "json":
        out = {}
        if entries and any(s == "stream" for s, _ in reqs):
            out["streams"] = streams_out
        if entries and any(s == "packet" for s, _ in reqs):
            out["packets"] = packets_out
        if entries and any(s == "format" for s, _ in reqs):
            out["format"] = fmt_out
        sys.stdout.write(json.dumps(_clean(out), indent=2))
        return 0

    if ofmt == "csv":
        for rows, sec in ((streams_out, "stream"), (packets_out, "packet"),
                          ([fmt_out], "format")):
            if not rows:
                continue
            for row in rows:
                if row is None:
                    continue
                vals = (["" if v is _MISS else v for v in row.values()]
                        if isinstance(row, dict) else [row])
                line = oopts["s"].join(str(v) for v in vals)
                if oopts["print_section"]:
                    line = f"{sec}={line}"
                sys.stdout.write(line + "\n")
        return 0

    for rows, sec in ((streams_out, "stream"), (packets_out, "packet"),
                      ([fmt_out] if fmt_out else [], "format")):
        if not rows:
            continue
        if not oopts["noprint_wrappers"]:
            sys.stdout.write(f"{sec}=\n")
        for row in rows:
            if row is None:
                continue
            if isinstance(row, dict):
                for k, v in row.items():
                    if v is _MISS:
                        continue
                    if oopts["nokey"]:
                        sys.stdout.write(f"{v}\n")
                    elif oopts["print_section"] and not oopts["noprint_wrappers"]:
                        sys.stdout.write(f"{sec}.{k}={v}\n")
                    else:
                        sys.stdout.write(f"{k}={v}\n")
            else:
                sys.stdout.write(f"{row}\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        sys.exit(0)
